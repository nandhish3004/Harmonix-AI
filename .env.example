# ==============================================================================
# HARMONIX-AR ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project Configuration (Required)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-jwt-key>

# Supabase Server Service Role Key (Optional / Server-Only)
# Never expose this key in client-side code (do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-jwt-key>

# Application Production URL (Required for OAuth Redirects)
# Set to your Vercel deployment domain (e.g., https://harmonix-ar.vercel.app)
NEXT_PUBLIC_APP_URL=https://<your-app-name>.vercel.app
NEXT_PUBLIC_SITE_URL=https://<your-app-name>.vercel.app
